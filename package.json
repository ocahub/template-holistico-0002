    "typecheck": "nuxt typecheck"
  },
  "dependencies": {
    "@ocahub/kit": "^0.16.0",
    "nuxt": "^4.5.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.0",
    "vue-tsc": "^3.1.0"
  }
}
