{
  "name": "template-holistico-0002",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Template de site holístico da plataforma (00047): astrologia, tarot e terapias, com a loja do @ocahub/kit e seções editáveis no painel",
  "scripts": {
    "dev": "nuxt dev --port 3023",
    "build": "nuxt build",
    "preview": "nuxt preview",
